{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDeploymentPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_DEPLOY_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "secure-ci-cd/*"
          ]
        }
      }
    },
    {
      "Sid": "WriteDeploymentArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_DEPLOY_BUCKET/secure-ci-cd/*"
    }
  ]
}
